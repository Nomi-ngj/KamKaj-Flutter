# ───── KamKaj API — STAGING ─────
APP_ENV=staging
PORT=3000
# Your local PostgreSQL. Create the database first:  createdb kamkaj_staging
# Homebrew / Postgres.app use your Mac username with no password. If you set a password, use:
#   postgresql://USER:PASSWORD@localhost:5432/kamkaj_staging?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kamkaj_staging?schema=public

# Long random strings. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Staging only: every verification code is this value and codes are printed in the server log.
FIXED_OTP=123456

# Comma-separated origins allowed to call the API from a browser (the admin panel).
CORS_ORIGINS=http://localhost:3001

# Public URL used to build links to uploaded images.
PUBLIC_BASE_URL=http://localhost:3000
