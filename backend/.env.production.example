# ───── KamKaj API — PRODUCTION ─────
# Copy to .env.production and fill in real values. Never commit .env.production.
APP_ENV=production
PORT=3000
DATABASE_URL=postgresql://kamkaj:CHANGE_ME@your-db-host:5432/kamkaj_production?schema=public

# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Must stay empty in production (the API refuses to start otherwise).
FIXED_OTP=

# Your live admin panel URL(s), comma-separated.
CORS_ORIGINS=https://admin.kamkaj.example
PUBLIC_BASE_URL=https://api.kamkaj.example
# API docs are off in production unless you turn them on.
SWAGGER_ENABLED=false
UPLOAD_DIR=uploads
